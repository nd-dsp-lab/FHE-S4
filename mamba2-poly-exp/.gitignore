# virtualenv / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# job logs: noisy, and they embed absolute cluster paths
logs/
*.log

# Experiment outputs. The RESULT files (csv / metrics.json / config.json) are
# committed on purpose -- they are the deliverable. What is excluded below is
# regenerable bulk:
#   transition_stats.json for the larger models holds per-head arrays for
#   thousands of heads (MBs each); polynomial_coefficients.json holds every
#   coefficient of every head. Both are reproduced by:
#       python collect_transition_stats.py --model <model> --blocks 64
runs/gpu/e2_scale/*/stats/transition_stats.json
runs/gpu/e2_scale/*/sweep/polynomial_coefficients.json
runs/gpu/e1_cross_domain/fit_stats/
runs/gpu/part9_finetune/*/polynomial_coefficients.json
runs/gpu/part10_distill/*/polynomial_coefficients.json
runs/_smoke/
runs/part7_zero_training_full/

# trained tensors from --save-weights
*.pt
